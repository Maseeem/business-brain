# Gemini powers existing Business Brain/RAG, SOP generation, voice transcription and receipt vision.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq + CrewAI power the multi-agent coordinator and specialized agents.
GROQ_API_KEY=your_groq_api_key_here
